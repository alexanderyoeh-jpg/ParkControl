# Referencia para el servidor; no contiene claves reales.
# Node no carga este archivo por sí solo: configura estos valores mediante
# systemd, Docker, PM2 o el gestor de secretos del VPS.

NODE_ENV=production
PORT=3000
# En un VPS con Nginx, la API no debe quedar expuesta directamente.
PARKCONTROL_HOST=127.0.0.1
PARKCONTROL_AUTH_SECRET=REEMPLAZAR_POR_SECRETO_DE_AL_MENOS_32_CARACTERES
PARKCONTROL_DB_PATH=/var/lib/parkcontrol/parkcontrol.db
PARKCONTROL_ALLOWED_ORIGINS=https://app.tu-dominio.cl
PARKCONTROL_TRUST_PROXY=true
# SQLite usa WAL y espera brevemente ante una escritura concurrente.
PARKCONTROL_SQLITE_BUSY_TIMEOUT_MS=5000

# El preflight y los respaldos requieren una ubicación distinta de la base.
# No subas respaldos ni sus hashes a Git.
PARKCONTROL_BACKUP_DIR=/var/backups/parkcontrol
PARKCONTROL_BACKUP_MIN_FREE_BYTES=1073741824

# Primera instalación: usar sólo mediante el gestor de secretos del VPS.
# En producción no existe setup HTTP ni usuarios demo. No subas esta clave a Git.
# PARKCONTROL_SUPERADMIN_EMAIL=propietario@tu-dominio.cl
# PARKCONTROL_SUPERADMIN_PASSWORD=CONTRASENA_DE_AL_MENOS_12_CARACTERES
# PARKCONTROL_SUPERADMIN_NOMBRE=Propietario ParkControl

# Mercado Pago: mantener fuera de Git y nunca copiar al cliente Flutter.
# La URL debe ser HTTPS en producción y apuntar a la API pública.
PARKCONTROL_PUBLIC_URL=https://api.tu-dominio.cl
PARKCONTROL_MERCADOPAGO_ACCESS_TOKEN=TEST_O_PRODUCCION_SOLO_EN_EL_SERVIDOR
PARKCONTROL_MERCADOPAGO_WEBHOOK_SECRET=SECRETO_DE_FIRMA_DE_WEBHOOK

# Informes Pro por correo: opcional. Resend usa un remitente/dominio verificado
# y su API se llama sólo desde el backend. No copies esta clave a Flutter.
# Mientras no se configure, las programaciones se pueden preparar pero no se
# envía ningún correo. Consulta docs/CONTRATO_INFORMES_CORREO_PRO.md antes de
# activarlo en producción.
# PARKCONTROL_EMAIL_PROVIDER=resend
# PARKCONTROL_RESEND_API_KEY=re_SOLO_EN_EL_GESTOR_DE_SECRETOS
# PARKCONTROL_EMAIL_FROM="ParkControl <informes@tu-dominio.cl>"
# PARKCONTROL_EMAIL_REPLY_TO=soporte@tu-dominio.cl
# PARKCONTROL_EMAIL_TIMEOUT_MS=15000
