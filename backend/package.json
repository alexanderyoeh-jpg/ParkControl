    "test:cola-correo": "node tests/cola_informes_correo.test.js",
    "test:resumen": "node tests/resumen_diario.test.js",
    "test:fecha-pdf": "node tests/formato_fecha.test.js",
    "test:plataformas": "node tests/plataformas_publicacion.test.js",
    "test:abonados": "node tests/abonados.test.js",
    "test:integracion": "node tests/superadmin.integration.js",
    "test": "npm run check && npm run test:config && npm run test:respaldo && npm run test:preflight && npm run test:correo && npm run test:cola-correo && npm run test:resumen && npm run test:fecha-pdf && npm run test:plataformas && npm run test:abonados && npm run test:integracion",
